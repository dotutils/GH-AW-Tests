6261427,"node_id":"MDQ6VXNlcjI2MjYxNDI3","avatar_url":"https://avatars.githubusercontent.com/u/26261427?v=4","html_url":"https://github.com/torronen","gravatar_id":"","type":"User","site_admin":false,"url":"https://api.github.com/users/torronen","events_url":"https://api.github.com/users/torronen/events{/privacy}","following_url":"https://api.github.com/users/torronen/following{/other_user}","followers_url":"https://api.github.com/users/torronen/followers","gists_url":"https://api.github.com/users/torronen/gists{/gist_id}","organizations_url":"https://api.github.com/users/torronen/orgs","received_events_url":"https://api.github.com/users/torronen/received_events","repos_url":"https://api.github.com/users/torronen/repos","starred_url":"https://api.github.com/users/torronen/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/torronen/subscriptions"},"reactions":{"total_count":0,"+1":0,"-1":0,"laugh":0,"confused":0,"heart":0,"hooray":0,"rocket":0,"eyes":0,"url":"https://api.github.com/repos/dotnet/machinelearning/issues/comments/1021215800/reactions"},"created_at":"2022-01-25T14:05:55Z","updated_at":"2022-01-27T16:27:32Z","author_association":"CONTRIBUTOR","url":"https://api.github.com/repos/dotnet/machinelearning/issues/comments/1021215800","html_url":"https://github.com/dotnet/machinelearning/issues/6045#issuecomment-1021215800","issue_url":"https://api.github.com/repos/dotnet/machinelearning/issues/6045"},{"id":1271819522,"node_id":"IC_kwDOB957rs5Lzm0C","body":"@torronen thanks for reporting this. Are you still running into this issue? \r\n\r\nSince this relates to the previous implementation of AutoML as well as an older version of ML.NET I'm inclined to close for now but if you're still seeing the issue I'll leave it open. \r\n\r\nThanks","user":{"login":"luisquintanilla","id":46974588,"node_id":"MDQ6VXNlcjQ2OTc0NTg4","avatar_url":"https://avatars.githubusercontent.com/u/46974588?v=4","html_url":"https://github.com/luisquintanilla","gravatar_