       label = filename.replace('_', ' ').replace('.json', '')\\n            print(f\\\"  {label:45} {count:4} items\\\")\\n            total_items += count\\n\\nprint(f\\\"\\\\n{'-'*70}\\\")\\nprint(f\\\"TOTAL ITEMS ACROSS ALL DATASETS: {total_items:,}\\\")\\nprint(f\\\"{'='*70}\\\")\",\"new_str\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"\\ndotnet/machinelearning Repository Health Data Collector\\n\\nThis script collects comprehensive health data from the dotnet/machinelearning\\nrepository using the GitHub CLI (gh).\\n\\nRequirements:\\n  - GitHub CLI (gh) installed and authenticated\\n  - Python 3.6+\\n\\nUsage:\\n  python3 collect_ml_health.py\\n\\nOutput:\\n  All JSON files are saved to the health-data/ directory with individual\\n  files for each metric category.\\n\\\"\\\"\\\"\\n\\nimport os\\nimport json\\nimport subprocess\\nfrom datetime import datetime, timedelta\\nimport sys\\n\\ndef main():\\n    # Create output directory\\n    os.makedirs('health-data', exist_ok=True)\\n\\n    # Calculate 7 days ago\\n    seven_days_ago = (datetime.utcnow() - timedelta(days=7)).strftime(\\\"%Y-%m-%dT%H:%M:%SZ\\\")\\n    print(f\\\"dotnet/machinelearning Health Data Collector\\\")\\n    print(f\\\"Seven days ago: {seven_days_ago}\\\\n\\\")\\n\\n    # List of all API commands organized by category\\n    commands = [\\n        # Management Metrics (M)\\n        (\\\"m1_untriaged.json\\\", \\\"/repos/dotnet/machinelearning/issues?labels=untriaged&state=open&sort=created&direction=desc&per_page=100\\\"),\\n        (\\\"m2_awaiting_input.json\\\", \\\"/repos/dotnet/machinelearning/issues?labels=Awaiting+User+Input&state=open&per_page=50\\\"),\\n        (\\\"m3_questions.json\\\", \\\"/repos/dotnet/machinelearning/issues?labels=question&state=open&sort=created&direction=asc&per_page=100\\\"),\\n        (\\\"m4_open_prs.json\\\", \\\"/repos/dotnet/machinelearning/pulls?state=open&sort=created&direction=asc&per_page=100\\\"),\\n        (\\\"m5_recent_updates.json\\\", \\\"/repos/dotnet/machinelearning/issues?state=open&sort=updated&direction=desc&per_page=50\\\"),\\n        \\n        # Workflow Metrics (W)\\n        (\\\"w1_failed_runs.json\\\", \\\"/repos/dotnet/machinelearning/actions/runs?branch=main&status=failure&per_page=50\\\"),\\n        (\\\"w2_all_runs.json\\\", \\\"/repos/dotnet/machinelearning/actions/runs?branch=main&per_page=100\\\"),\\n        (\\\"w3_cancelled.json\\\", \\\"/repos/dotnet/machinelearning/actions/runs?branch=main&status=cancelled&per_page=20\\\"),\\n        (\\\"w4_blocking_ci.json\\\", \\\"/repos/dotnet/machinelearning/issues?labels=blocking-clean-ci&state=open&per_page=10\\\"),\\n        (\\\"w4_build_errors.json\\\", \\\"/repos/dotnet/machinelearning/issues?labels=Known+Build+Error&state=open&per_page=10\\\"),\\n        (\\\"w4_commit_status.json\\\", \\\"/repos/dotnet/machinelearning/commits/main/status\\\"),\\n        \\n        # Critical Issues (C)\\n        (\\\"c1_p0.json\\\", \\\"/repos/dotnet/machinelearning/issues?labels=P0&state=open&per_page=20\\\"),\\n        (\\\"c1_p1.json\\\", \\\"/repos/dotnet/machinelearning/issues?labels=P1&state=open&per_page=100\\\"),\\n        (\\\"c2_bugs.json\\\", \\\"/repos/dotnet/machinelearning/issues?labels=bug&state=open&per_page=100\\\"),\\n        (\\\"c5_security.json\\\", \\\"/repos/dotnet/machinelearning/issues?labels=Security&state=open&per_page=20\\\"),\\n        (\\\"c7_recent_issues_7d.json\\\", f\\\"/repos/dotnet/machinelearning/issues?state=all&sort=created&direction=desc&per_page=100&since={seven_days_ago}\\\"),\\n        (\\\"c7_closed_issues.json\\\", \\\"/repos/dotnet/machinelearning/issues?state=closed&sort=updated&direction=desc&per_page=100\\\"),\\n        (\\\"c7_closed_prs.json\\\", \\\"/repos/dotnet/machinelearning/pulls?state=closed&sort=updated&direction=desc&per_page=100\\\"),\\n        \\n        # Repository Information\\n        (\\\"repo_info.json\\\", \\\"/repos/dotnet/machinelearning\\\"),\\n        (\\\"health_dashboard.json\\\", \\\"/repos/dotnet/machinelearning/issues?labels=repo-health&state=open&per_page=5\\\"),\\n    ]\\n\\n    print(f\\\"Collecting {len(commands)} datasets...\\\\n\\\")\\n\\n    success_count = 0\\n    failed_count = 0\\n    summary = {}\\n\\n    for i, (filename, endpoint) in enumerate(commands, 1):\\n        filepath = os.path.join('health-data', filename)\\n        print(f\\\"{i:2}. {filename:35}\\\", end=\\\" \\\", flush=True)\\n        \\n        try:\\n            result = subprocess.run(['gh', 'api', endpoint], capture_output=True, text=True, timeout=30)\\n            if result.returncode == 0:\\n                with open(filepath, 'w') as f:\\n                    f.write(result.stdout)\\n                size = len(result.stdout)\\n                \\n                # Parse JSON and count items\\n                try:\\n                    data = json.loads(result.stdout)\\n                    if isinstance(data, dict):\\n                        if 'items' in data:\\n                            count = len(data.get('items', []))\\n                        elif 'workflow_runs' in data:\\n                            count = len(data.get('workflow_runs', []))\\n                        elif 'statuses' in data:\\n                            count = len(data.get('statuses', []))\\n                        else:\\n                            count = 0\\n                    elif isinstance(data, list):\\n                        count = len(data)\\n                    else:\\n                        count = 0\\n                except:\\n                    count = 0\\n                \\n                summary[filename] = count\\n                print(f\\\"✓ ({count:3} items, {size:,} bytes)\\\")\\n                success_count += 1\\n            else:\\n                error_msg = result.stderr.split('\\\\n')[0][:50] if result.stderr else \\\"Unknown error\\\"\\n                print(f\\\"✗ Error: {error_msg}\\\")\\n                with open(filepath, 'w') as f:\\n                    f.write('{}')\\n                summary[filename] = 0\\n                failed_count += 1\\n        except Exception as e:\\n            print(f\\\"✗ Exception: {str(e)[:50]}\\\")\\n            with open(filepath, 'w') as f:\\n                f.write('{}')\\n            summary[filename] = 0\\n            failed_count += 1\\n\\n    print(f\\\"\\\\n{'='*70}\\\")\\n    print(f\\\"Completed: {success_count}/{len(commands)} successful API calls ({failed_count} failed)\\\")\\n    print(f\\\"Output directory: health-data/\\\")\\n    print(f\\\"{'='*70}\\\\n\\\")\\n\\n    # Generate summary statistics\\n    print(\\\"SUMMARY STATISTICS:\\\")\\n    print(\\\"-\\\" * 70)\\n\\n    # Group and display summaries\\n    categories = {\\n        \\\"Management Metrics (M)\\\": [k for k in summary.keys() if k.startswith('m')],\\n        \\\"Workflow Metrics (W)\\\": [k for k in summary.keys() if k.startswith('w')],\\n        \\\"Critical Issues (C)\\\": [k for k in summary.keys() if k.startswith('c')],\\n        \\\"Repository (R)\\\": [k for k in summary.keys() if not k[0] in ['m', 'w', 'c']],\\n    }\\n\\n    total_items = 0\\n    for category, files in categories.items():\\n        if files:\\n            print(f\\\"\\\\n{category}:\\\")\\n            for filename in sorted(files):\\n                count = summary[filename]\\n                label = filename.replace('_', ' ').replace('.json', '')\\n                print(f\\\"  {label:45} {count:6} items\\\")\\n                total_items += count\\n\\n    print(f\\\"\\\\n{'-'*70}\\\")\\n    print(f\\\"TOTAL ITEMS ACROSS ALL DATASETS: {total_items:,}\\\")\\n    print(f\\\"{'='*70}\\\\n\\\")\\n    \\n    print(\\\"✓ Health data collection complete!\\\")\\n    print(f\\\"✓ All files saved to: health-data/\\\")\\n    print()\\n\\nif __name__ == '__main__':\\n    try:\\n        main()\\n    except KeyboardInterrupt:\\n        print(\\\"\\\\n\\\\nCollection cancelled by user.\\\")\\n        sys.exit(1)\\n    except Exception as e:\\n        print(f\\\"\\\\n\\\\nError during collection: {e}\\\")\\n        sys.exit(1)\"}",
