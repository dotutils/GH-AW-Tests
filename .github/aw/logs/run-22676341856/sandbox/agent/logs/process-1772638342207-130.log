              "arguments": "{\"file_text\":\"#!/usr/bin/env python3\\n\\\"\\\"\\\"\\ndotnet/machinelearning Health Data Analyzer\\n\\nAnalyzes health data collected from the dotnet/machinelearning repository.\\n\\nUsage:\\n  python3 analyze_health_data.py\\n\\nThis script reads JSON files from the health-data/ directory and produces\\na comprehensive analysis report.\\n\\\"\\\"\\\"\\n\\nimport json\\nimport os\\nfrom datetime import datetime\\nfrom collections import defaultdict\\n\\ndef load_json_file(filepath):\\n    \\\"\\\"\\\"Load and parse a JSON file.\\\"\\\"\\\"\\n    try:\\n        with open(filepath, 'r') as f:\\n            return json.load(f)\\n    except:\\n        return {}\\n\\ndef analyze_health_data():\\n    \\\"\\\"\\\"Main analysis function.\\\"\\\"\\\"\\n    \\n    health_dir = 'health-data'\\n    \\n    if not os.path.exists(health_dir):\\n        print(f\\\"Error: {health_dir}/ directory not found.\\\")\\n        print(\\\"Please run collect_ml_health.py first.\\\")\\n        return\\n    \\n    print(\\\"=\\\" * 80)\\n    print(\\\"dotnet/machinelearning HEALTH DATA ANALYSIS\\\")\\n    print(\\\"=\\\" * 80)\\n    print()\\n    \\n    # Load all data files\\n    files_data = {}\\n    for filename in sorted(os.listdir(health_dir)):\\n        if filename.endswith('.json'):\\n            filepath = os.path.join(health_dir, filename)\\n            files_data[filename] = load_json_file(filepath)\\n    \\n    print(f\\\"Loaded {len(files_data)} data files\\\")\\n    print()\\n    \\n    # MANAGEMENT METRICS ANALYSIS\\n    print(\\\"=\\\" * 80)\\n    print(\\\"MANAGEMENT METRICS (M)\\\")\\n    print(\\\"=\\\" * 80)\\n    \\n    m1_data = files_data.get('m1_untriaged.json', {})\\n    m1_count = len(m1_data.get('items', []))\\n    print(f\\\"\\\\nM1 - Untriaged Issues: {m1_count}\\\")\\n    if m1_count > 0:\\n        print(f\\\"  Oldest: {m1_data['items'][-1]['created_at']}\\\")\\n        print(f\\\"  Newest: {m1_data['items'][0]['created_at']}\\\")\\n    \\n    m2_data = files_data.get('m2_awaiting_input.json', {})\\n    m2_count = len(m2_data.get('items', []))\\n    print(f\\\"\\\\nM2 - Awaiting User Input: {m2_count}\\\")\\n    \\n    m3_data = files_data.get('m3_questions.json', {})\\n    m3_count = len(m3_data.get('items', []))\\n    print(f\\\"\\\\nM3 - Questions: {m3_count}\\\")\\n    \\n    m4_data = files_data.get('m4_open_prs.json', {})\\n    m4_count = len(m4_data.get('items', []))\\n    print(f\\\"\\\\nM4 - Open Pull Requests: {m4_count}\\\")\\n    if m4_count > 0:\\n        print(f\\\"  Oldest: {m4_data['items'][-1]['created_at']}\\\")\\n        print(f\\\"  Most recent: {m4_data['items'][0]['created_at']}\\\")\\n    \\n    m5_data = files_data.get('m5_recent_updates.json', {})\\n    m5_count = len(m5_data.get('items', []))\\n    print(f\\\"\\\\nM5 - Recently Updated Issues: {m5_count}\\\")\\n    if m5_count > 0:\\n        print(f\\\"  Most recent update: {m5_data['items'][0]['updated_at']}\\\")\\n    \\n    # WORKFLOW METRICS ANALYSIS\\n    print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n    print(\\\"WORKFLOW METRICS (W)\\\")\\n    print(\\\"=\\\" * 80)\\n    \\n    w1_data = files_data.get('w1_failed_runs.json', {})\\n    w1_count = len(w1_data.get('workflow_runs', []))\\n    print(f\\\"\\\\nW1 - Failed CI Runs: {w1_count}\\\")\\n    \\n    w2_data = files_data.get('w2_all_runs.json', {})\\n    w2_count = len(w2_data.get('workflow_runs', []))\\n    print(f\\\"\\\\nW2 - All CI Runs: {w2_count}\\\")\\n    if w2_count > 0:\\n        # Analyze run statuses\\n        statuses = defaultdict(int)\\n        for run in w2_data.get('workflow_runs', []):\\n            statuses[run.get('status', 'unknown')] += 1\\n        print(\\\"  Status breakdown:\\\")\\n        for status, count in sorted(statuses.items(), key=lambda x: -x[1]):\\n            pct = (count / w2_count) * 100\\n            print(f\\\"    {status}: {count} ({pct:.1f}%)\\\")\\n    \\n    w3_data = files_data.get('w3_cancelled.json', {})\\n    w3_count = len(w3_data.get('workflow_runs', []))\\n    print(f\\\"\\\\nW3 - Cancelled Runs: {w3_count}\\\")\\n    \\n    w4_blocking = files_data.get('w4_blocking_ci.json', {})\\n    w4_blocking_count = len(w4_blocking.get('items', []))\\n    print(f\\\"\\\\nW4 - Blocking CI Issues: {w4_blocking_count}\\\")\\n    \\n    w4_errors = files_data.get('w4_build_errors.json', {})\\n    w4_errors_count = len(w4_errors.get('items', []))\\n    print(f\\\"\\\\nW4 - Known Build Errors: {w4_errors_count}\\\")\\n    \\n    w4_status = files_data.get('w4_commit_status.json', {})\\n    if 'state' in w4_status:\\n        print(f\\\"\\\\nW4 - Main Branch Status: {w4_status['state'].upper()}\\\")\\n        if 'statuses' in w4_status:\\n            print(f\\\"  Total checks: {len(w4_status['statuses'])}\\\")\\n    \\n    # CRITICAL ISSUES ANALYSIS\\n    print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n    print(\\\"CRITICAL ISSUES (C)\\\")\\n    print(\\\"=\\\" * 80)\\n    \\n    c1_p0 = files_data.get('c1_p0.json', {})\\n    c1_p0_count = len(c1_p0.get('items', []))\\n    print(f\\\"\\\\nC1 - P0 Priority Issues: {c1_p0_count}\\\")\\n    if c1_p0_count > 0:\\n        print(\\\"  Sample issues:\\\")\\n        for issue in c1_p0.get('items', [])[:3]:\\n            print(f\\\"    - #{issue['number']}: {issue['title'][:60]}\\\")\\n    \\n    c1_p1 = files_data.get('c1_p1.json', {})\\n    c1_p1_count = len(c1_p1.get('items', []))\\n    print(f\\\"\\\\nC1 - P1 Priority Issues: {c1_p1_count}\\\")\\n    \\n    c2_bugs = files_data.get('c2_bugs.json', {})\\n    c2_bugs_count = len(c2_bugs.get('items', []))\\n    print(f\\\"\\\\nC2 - Bug Reports: {c2_bugs_count}\\\")\\n    \\n    c5_security = files_data.get('c5_security.json', {})\\n    c5_security_count = len(c5_security.get('items', []))\\n    print(f\\\"\\\\nC5 - Security Issues: {c5_security_count}\\\")\\n    \\n    c7_recent = files_data.get('c7_recent_issues_7d.json', {})\\n    c7_recent_count = len(c7_recent.get('items', []))\\n    print(f\\\"\\\\nC7 - Issues Created (Last 7 days): {c7_recent_count}\\\")\\n    \\n    c7_closed_issues = files_data.get('c7_closed_issues.json', {})\\n    c7_closed_issues_count = len(c7_closed_issues.get('items', []))\\n    print(f\\\"\\\\nC7 - Recently Closed Issues: {c7_closed_issues_count}\\\")\\n    \\n    c7_closed_prs = files_data.get('c7_closed_prs.json', {})\\n    c7_closed_prs_count = len(c7_closed_prs.get('items', []))\\n    print(f\\\"\\\\nC7 - Recently Closed PRs: {c7_closed_prs_count}\\\")\\n    \\n    # REPOSITORY INFORMATION\\n    print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n    print(\\\"REPOSITORY INFORMATION\\\")\\n    print(\\\"=\\\" * 80)\\n    \\n    repo_info = files_data.get('repo_info.json', {})\\n    if repo_info:\\n        print(f\\\"\\\\nName: {repo_info.get('name', 'N/A')}\\\")\\n        print(f\\\"Full Name: {repo_info.get('full_name', 'N/A')}\\\")\\n        print(f\\\"Description: {repo_info.get('description', 'N/A')[:100]}\\\")\\n        print(f\\\"Stars: {repo_info.get('stargazers_count', 0):,}\\\")\\n        print(f\\\"Watchers: {repo_info.get('watchers_count', 0):,}\\\")\\n        print(f\\\"Forks: {repo_info.get('forks_count', 0):,}\\\")\\n        print(f\\\"Open Issues: {repo_info.get('open_issues_count', 0)}\\\")\\n        print(f\\\"Primary Language: {repo_info.get('language', 'N/A')}\\\")\\n        print(f\\\"Created: {repo_info.get('created_at', 'N/A')}\\\")\\n        print(f\\\"Last Push: {repo_info.get('pushed_at', 'N/A')}\\\")\\n    \\n    health_dashboard = files_data.get('health_dashboard.json', {})\\n    hd_count = len(health_dashboard.get('items', []))\\n    print(f\\\"\\\\nHealth Dashboard Issues: {hd_count}\\\")\\n    \\n    # SUMMARY STATISTICS\\n    print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n    print(\\\"SUMMARY\\\")\\n    print(\\\"=\\\" * 80)\\n    \\n    total_open_issues = (m1_count + m2_count + m3_count + c1_p0_count + \\n                         c1_p1_count + c2_bugs_count + c5_security_count)\\n    print(f\\\"\\\\nTotal Open Issues (unique): ~{total_open_issues}\\\")\\n    print(f\\\"Open PRs: {m4_count}\\\")\\n    print(f\\\"Total CI Runs (recent): {w2_count}\\\")\\n    print(f\\\"Failed CI Runs: {w1_count} ({(w1_count/max(w2_count, 1)*100):.1f}%)\\\")\\n    print(f\\\"Issues Created (7 days): {c7_recent_count}\\\")\\n    print(f\\\"Issues Closed (recent): {c7_closed_issues_count}\\\")\\n    print(f\\\"PRs Closed (recent): {c7_closed_prs_count}\\\")\\n    \\n    # Health Score\\n    print(\\\"\\\\n\\\" + \\\"=\\\" * 80)\\n    print(\\\"HEALTH ASSESSMENT\\\")\\n    print(\\\"=\\\" * 80)\\n    print()\\n    \\n    issues = []\\n    \\n    if c1_p0_count > 0:\\n        issues.append(f\\\"⚠️  {c1_p0_count} P0 priority issues requiring immediate attention\\\")\\n    \\n    if m1_count > 10:\\n        issues.append(f\\\"⚠️  {m1_count} untriaged issues accumulating\\\")\\n    \\n    if m2_count > 5:\\n        issues.append(f\\\"⚠️  {m2_count} issues awaiting user input response\\\")\\n    \\n    if w1_count > 5:\\n        issues.append(f\\\"⚠️  {w1_count} failed CI runs on main branch\\\")\\n    \\n    if c5_security_count > 0:\\n        issues.append(f\\\"🔒  {c5_security_count} security issues open\\\")\\n    \\n    if not issues:\\n        print(\\\"✓ Repository health looks good!\\\")\\n        print(\\\"  - No critical P0 issues\\\")\\n        print(\\\"  - Low number of untriaged issues\\\")\\n        print(\\\"  - CI generally passing\\\")\\n    else:\\n        print(\\\"Areas for attention:\\\")\\n        for issue in issues:\\n            print(f\\\"  {issue}\\\")\\n    \\n    print()\\n    print(\\\"=\\\" * 80)\\n\\nif __name__ == '__main__':\\n    analyze_health_data()\\n\",\"path\":\"/home/runner/work/GH-AW-Tests/GH-AW-Tests/analyze_health_data.py\"}",
