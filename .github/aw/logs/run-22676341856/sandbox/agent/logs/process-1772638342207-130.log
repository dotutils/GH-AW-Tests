            "function": {
              "arguments": "{\"file_text\":\"#!/bin/bash\\n#\\n# dotnet/machinelearning Repository Health Data Collector\\n#\\n# This script collects comprehensive health data from the dotnet/machinelearning\\n# repository using the GitHub CLI (gh).\\n#\\n# Requirements:\\n#   - GitHub CLI (gh) installed and authenticated\\n#   - bash 4.0+\\n#   - Standard Unix tools (date, mkdir, etc.)\\n#\\n# Usage:\\n#   chmod +x collect_health.sh\\n#   ./collect_health.sh\\n#\\n# Output:\\n#   All JSON files are saved to the health-data/ directory with individual\\n#   files for each metric category.\\n\\nset -e\\n\\necho \\\"dotnet/machinelearning Repository Health Data Collector\\\"\\necho \\\"========================================================\\\"\\necho \\\"\\\"\\n\\n# Create output directory\\nmkdir -p health-data\\ncd health-data\\n\\n# Calculate 7 days ago (compatible with both GNU and BSD date)\\nif date --version 2>/dev/null | grep -q GNU; then\\n    SEVEN_DAYS_AGO=$(date -u -d '7 days ago' +\\\"%Y-%m-%dT%H:%M:%SZ\\\")\\nelse\\n    SEVEN_DAYS_AGO=$(date -u -v-7d +\\\"%Y-%m-%dT%H:%M:%SZ\\\")\\nfi\\n\\necho \\\"Seven days ago: $SEVEN_DAYS_AGO\\\"\\necho \\\"\\\"\\necho \\\"Running API calls...\\\"\\necho \\\"\\\"\\n\\nSUCCESS_COUNT=0\\nFAILED_COUNT=0\\n\\n# Function to run API call and save result\\nrun_api_call() {\\n    local num=$1\\n    local filename=$2\\n    local endpoint=$3\\n    \\n    printf \\\"%2d. %-35s \\\" \\\"$num\\\" \\\"$filename\\\"\\n    \\n    if gh api \\\"$endpoint\\\" > \\\"$filename\\\" 2>&1; then\\n        local size=$(wc -c < \\\"$filename\\\")\\n        printf \\\"✓ (%d bytes)\\\\n\\\" \\\"$size\\\"\\n        SUCCESS_COUNT=$((SUCCESS_COUNT + 1))\\n    else\\n        printf \\\"✗ Error\\\\n\\\"\\n        echo '{}' > \\\"$filename\\\"\\n        FAILED_COUNT=$((FAILED_COUNT + 1))\\n    fi\\n}\\n\\n# Management Metrics (M)\\nrun_api_call 1 \\\"m1_untriaged.json\\\" \\\"/repos/dotnet/machinelearning/issues?labels=untriaged&state=open&sort=created&direction=desc&per_page=100\\\"\\nrun_api_call 2 \\\"m2_awaiting_input.json\\\" \\\"/repos/dotnet/machinelearning/issues?labels=Awaiting+User+Input&state=open&per_page=50\\\"\\nrun_api_call 3 \\\"m3_questions.json\\\" \\\"/repos/dotnet/machinelearning/issues?labels=question&state=open&sort=created&direction=asc&per_page=100\\\"\\nrun_api_call 4 \\\"m4_open_prs.json\\\" \\\"/repos/dotnet/machinelearning/pulls?state=open&sort=created&direction=asc&per_page=100\\\"\\nrun_api_call 5 \\\"m5_recent_updates.json\\\" \\\"/repos/dotnet/machinelearning/issues?state=open&sort=updated&direction=desc&per_page=50\\\"\\n\\n# Workflow Metrics (W)\\nrun_api_call 6 \\\"w1_failed_runs.json\\\" \\\"/repos/dotnet/machinelearning/actions/runs?branch=main&status=failure&per_page=50\\\"\\nrun_api_call 7 \\\"w2_all_runs.json\\\" \\\"/repos/dotnet/machinelearning/actions/runs?branch=main&per_page=100\\\"\\nrun_api_call 8 \\\"w3_cancelled.json\\\" \\\"/repos/dotnet/machinelearning/actions/runs?branch=main&status=cancelled&per_page=20\\\"\\nrun_api_call 9 \\\"w4_blocking_ci.json\\\" \\\"/repos/dotnet/machinelearning/issues?labels=blocking-clean-ci&state=open&per_page=10\\\"\\nrun_api_call 10 \\\"w4_build_errors.json\\\" \\\"/repos/dotnet/machinelearning/issues?labels=Known+Build+Error&state=open&per_page=10\\\"\\nrun_api_call 11 \\\"w4_commit_status.json\\\" \\\"/repos/dotnet/machinelearning/commits/main/status\\\"\\n\\n# Critical Issues (C)\\nrun_api_call 12 \\\"c1_p0.json\\\" \\\"/repos/dotnet/machinelearning/issues?labels=P0&state=open&per_page=20\\\"\\nrun_api_call 13 \\\"c1_p1.json\\\" \\\"/repos/dotnet/machinelearning/issues?labels=P1&state=open&per_page=100\\\"\\nrun_api_call 14 \\\"c2_bugs.json\\\" \\\"/repos/dotnet/machinelearning/issues?labels=bug&state=open&per_page=100\\\"\\nrun_api_call 15 \\\"c5_security.json\\\" \\\"/repos/dotnet/machinelearning/issues?labels=Security&state=open&per_page=20\\\"\\nrun_api_call 16 \\\"c7_recent_issues_7d.json\\\" \\\"/repos/dotnet/machinelearning/issues?state=all&sort=created&direction=desc&per_page=100&since=$SEVEN_DAYS_AGO\\\"\\nrun_api_call 17 \\\"c7_closed_issues.json\\\" \\\"/repos/dotnet/machinelearning/issues?state=closed&sort=updated&direction=desc&per_page=100\\\"\\nrun_api_call 18 \\\"c7_closed_prs.json\\\" \\\"/repos/dotnet/machinelearning/pulls?state=closed&sort=updated&direction=desc&per_page=100\\\"\\n\\n# Repository Information\\nrun_api_call 19 \\\"repo_info.json\\\" \\\"/repos/dotnet/machinelearning\\\"\\nrun_api_call 20 \\\"health_dashboard.json\\\" \\\"/repos/dotnet/machinelearning/issues?labels=repo-health&state=open&per_page=5\\\"\\n\\necho \\\"\\\"\\necho \\\"========================================================\\\"\\necho \\\"Completed: $SUCCESS_COUNT/20 successful, $FAILED_COUNT failed\\\"\\necho \\\"Output directory: health-data/\\\"\\necho \\\"========================================================\\\"\\necho \\\"\\\"\\necho \\\"Files created:\\\"\\nls -lh *.json | awk '{printf \\\"  %-35s %8s\\\\n\\\", $9, $5}'\\necho \\\"\\\"\\n\",\"path\":\"/home/runner/work/GH-AW-Tests/GH-AW-Tests/collect_health.sh\"}",
