        "tool_calls": [
          {
            "function": {
              "arguments": "{\"file_text\":\"# Health Data Usage Examples\\n\\nThis document provides practical examples for using the collected health data.\\n\\n---\\n\\n## Quick Examples\\n\\n### View Count Summary\\n```bash\\n# After running collect_ml_health.py\\ncd health-data\\nfor file in *.json; do\\n  count=$(python3 -c \\\"import json; d=json.load(open('$file')); print(len(d.get('items', d.get('workflow_runs', []))))\\\")\\n  echo \\\"$file: $count items\\\"\\ndone\\n```\\n\\n### Find All P0 Issues\\n```bash\\npython3 -c \\\"\\nimport json\\nwith open('health-data/c1_p0.json') as f:\\n    data = json.load(f)\\n    for issue in data['items']:\\n        print(f\\\\\\\"#{issue['number']}: {issue['title']}\\\\\\\")\\n        print(f\\\\\\\"  Created: {issue['created_at']}\\\\\\\")\\n        print(f\\\\\\\"  URL: {issue['html_url']}\\\\\\\")\\n        print()\\n\\\"\\n```\\n\\n### Count Issues by Label\\n```bash\\npython3 -c \\\"\\nimport json\\nfrom collections import defaultdict\\n\\nlabels = defaultdict(int)\\n\\n# Load all issue files\\nfor filename in ['m1_untriaged.json', 'c1_p0.json', 'c1_p1.json', 'c2_bugs.json', 'c5_security.json']:\\n    try:\\n        with open(f'health-data/{filename}') as f:\\n            data = json.load(f)\\n            for issue in data.get('items', []):\\n                for label in issue.get('labels', []):\\n                    labels[label['name']] += 1\\n    except:\\n        pass\\n\\nfor label, count in sorted(labels.items(), key=lambda x: -x[1])[:20]:\\n    print(f'{label}: {count}')\\n\\\"\\n```\\n\\n### List Issues Older Than N Days\\n```bash\\npython3 << 'EOF'\\nimport json\\nfrom datetime import datetime, timedelta\\n\\nDAYS_OLD = 30\\ncutoff_date = datetime.utcnow() - timedelta(days=DAYS_OLD)\\n\\nold_issues = []\\n\\nwith open('health-data/m1_untriaged.json') as f:\\n    data = json.load(f)\\n    for issue in data['items']:\\n        created = datetime.fromisoformat(issue['created_at'].replace('Z', '+00:00'))\\n        if created < cutoff_date:\\n            old_issues.append((issue['number'], issue['title'], issue['created_at']))\\n\\nprint(f\\\"Issues untriaged for more than {DAYS_OLD} days:\\\")\\nfor number, title, date in sorted(old_issues):\\n    print(f\\\"  #{number}: {title} (created {date})\\\")\\nEOF\\n```\\n\\n---\\n\\n## Analysis Patterns\\n\\n### Health Score Calculation\\n```python\\nimport json\\n\\ndef calculate_health_score():\\n    \\\"\\\"\\\"Calculate overall repository health score 0-100\\\"\\\"\\\"\\n    \\n    scores = {}\\n    \\n    # Management - aim for minimal untriaged/awaiting input\\n    with open('health-data/m1_untriaged.json') as f:\\n        untriaged = len(json.load(f).get('items', []))\\n        scores['management'] = max(0, 100 - (untriaged * 2))  # 2 points per untriaged\\n    \\n    # Workflow - aim for no failed runs\\n    with open('health-data/w1_failed_runs.json') as f:\\n        failed = len(json.load(f).get('workflow_runs', []))\\n        scores['workflow'] = max(0, 100 - (failed * 10))\\n    \\n    # Critical - aim for no P0\\n    with open('health-data/c1_p0.json') as f:\\n        p0 = len(json.load(f).get('items', []))\\n        scores['critical'] = max(0, 100 - (p0 * 30))\\n    \\n    # Overall average\\n    overall = sum(scores.values()) / len(scores)\\n    \\n    print(f\\\"Health Score Breakdown:\\\")\\n    for category, score in scores.items():\\n        print(f\\\"  {category}: {score:.0f}/100\\\")\\n    print(f\\\"  Overall: {overall:.0f}/100\\\")\\n    \\n    return overall\\n\\ncalculate_health_score()\\n```\\n\\n### Trend Analysis\\n```python\\nimport json\\nfrom datetime import datetime\\nfrom collections import defaultdict\\n\\ndef analyze_trends():\\n    \\\"\\\"\\\"Analyze issue creation trends\\\"\\\"\\\"\\n    \\n    daily_counts = defaultdict(int)\\n    \\n    with open('health-data/c7_recent_issues_7d.json') as f:\\n        data = json.load(f)\\n        for issue in data['items']:\\n            date = issue['created_at'][:10]  # YYYY-MM-DD\\n            daily_counts[date] += 1\\n    \\n    print(\\\"Issues created per day (last 7 days):\\\")\\n    for date in sorted(daily_counts.keys()):\\n        count = daily_counts[date]\\n        bar = '█' * (count // 5)\\n        print(f\\\"  {date}: {bar} ({count})\\\")\\n    \\n    total = sum(daily_counts.values())\\n    avg = total / len(daily_counts) if daily_counts else 0\\n    print(f\\\"\\\\nAverage: {avg:.1f} issues/day\\\")\\n\\nanalyze_trends()\\n```\\n\\n---\\n\\n## Export Examples\\n\\n### Export to CSV\\n```python\\nimport json\\nimport csv\\n\\ndef export_p0_to_csv():\\n    \\\"\\\"\\\"Export P0 issues to CSV file\\\"\\\"\\\"\\n    \\n    with open('health-data/c1_p0.json') as f:\\n        data = json.load(f)\\n    \\n    with open('p0_issues.csv', 'w', newline='') as f:\\n        writer = csv.writer(f)\\n        writer.writerow(['Number', 'Title', 'Created', 'Updated', 'Assignee', 'Labels'])\\n        \\n        for issue in data['items']:\\n            labels = ', '.join([l['name'] for l in issue['labels']])\\n            writer.writerow([\\n                issue['number'],\\n                issue['title'],\\n                issue['created_at'],\\n                issue['updated_at'],\\n                issue['assignee']['login'] if issue['assignee'] else 'Unassigned',\\n                labels\\n            ])\\n    \\n    print(f\\\"Exported {len(data['items'])} P0 issues to p0_issues.csv\\\")\\n\\nexport_p0_to_csv()\\n```\\n\\n### Export to Markdown\\n```python\\nimport json\\n\\ndef export_summary_markdown():\\n    \\\"\\\"\\\"Export summary as Markdown report\\\"\\\"\\\"\\n    \\n    with open('HEALTH_REPORT.md', 'w') as report:\\n        report.write(\\\"# dotnet/machinelearning Health Report\\\\n\\\\n\\\")\\n        \\n        # Management section\\n        report.write(\\\"## Management Metrics\\\\n\\\\n\\\")\\n        \\n        with open('health-data/m1_untriaged.json') as f:\\n            count = len(json.load(f).get('items', []))\\n            report.write(f\\\"- **Untriaged Issues:** {count}\\\\n\\\")\\n        \\n        with open('health-data/m2_awaiting_input.json') as f:\\n            count = len(json.load(f).get('items', []))\\n            report.write(f\\\"- **Awaiting Input:** {count}\\\\n\\\")\\n        \\n        with open('health-data/m4_open_prs.json') as f:\\n            count = len(json.load(f).get('items', []))\\n            report.write(f\\\"- **Open PRs:** {count}\\\\n\\\\n\\\")\\n        \\n        # Critical Issues\\n        report.write(\\\"## Critical Issues\\\\n\\\\n\\\")\\n        \\n        with open('health-data/c1_p0.json') as f:\\n            issues = json.load(f).get('items', [])\\n            report.write(f\\\"### P0 Issues ({len(issues)})\\\\n\\\\n\\\")\\n            for issue in issues:\\n                report.write(f\\\"- [#{issue['number']}]({issue['html_url']}): {issue['title']}\\\\n\\\")\\n    \\n    print(\\\"Report exported to HEALTH_REPORT.md\\\")\\n\\nexport_summary_markdown()\\n```\\n\\n---\\n\\n## Filtering Examples\\n\\n### Find Unassigned P1 Issues\\n```python\\nimport json\\n\\nwith open('health-data/c1_p1.json') as f:\\n    data = json.load(f)\\n    unassigned = [i for i in data['items'] if i['assignee'] is None]\\n    \\n    print(f\\\"Unassigned P1 Issues: {len(unassigned)}\\\")\\n    for issue in unassigned[:10]:\\n        print(f\\\"  #{issue['number']}: {issue['title']}\\\")\\n```\\n\\n### Find Issues with Specific Labels\\n```python\\nimport json\\n\\ntarget_labels = {'bug', 'enhancement', 'documentation'}\\n\\nwith open('health-data/c2_bugs.json') as f:\\n    data = json.load(f)\\n    matching = []\\n    \\n    for issue in data['items']:\\n        issue_labels = {l['name'] for l in issue['labels']}\\n        if issue_labels & target_labels:  # Intersection\\n            matching.append(issue)\\n    \\n    print(f\\\"Issues with multiple labels: {len(matching)}\\\")\\n```\\n\\n### Find Recently Updated Issues\\n```python\\nimport json\\nfrom datetime import datetime, timedelta\\n\\nHOURS_RECENT = 24\\ncutoff = datetime.utcnow() - timedelta(hours=HOURS_RECENT)\\n\\nwith open('health-data/m5_recent_updates.json') as f:\\n    data = json.load(f)\\n    recent = []\\n    \\n    for issue in data['items']:\\n        updated = datetime.fromisoformat(issue['updated_at'].replace('Z', '+00:00'))\\n        if updated > cutoff:\\n            recent.append(issue)\\n    \\n    print(f\\\"Issues updated in last {HOURS_RECENT} hours: {len(recent)}\\\")\\n```\\n\\n---\\n\\n## Workflow Analysis\\n\\n### Analyze CI Run Statistics\\n```python\\nimport json\\nfrom collections import defaultdict\\n\\nwith open('health-data/w2_all_runs.json') as f:\\n    data = json.load(f)\\n    runs = data['workflow_runs']\\n    \\n    # Status breakdown\\n    statuses = defaultdict(int)\\n    conclusions = defaultdict(int)\\n    \\n    for run in runs:\\n        statuses[run['status']] += 1\\n        conclusions[run.get('conclusion', 'pending')] += 1\\n    \\n    print(\\\"Workflow Run Status:\\\")\\n    for status, count in sorted(statuses.items()):\\n        print(f\\\"  {status}: {count}\\\")\\n    \\n    print(\\\"\\\\nWorkflow Conclusions:\\\")\\n    for conclusion, count in sorted(conclusions.items()):\\n        print(f\\\"  {conclusion}: {count}\\\")\\n    \\n    # Calculate success rate\\n    success = conclusions.get('success', 0)\\n    total = sum(conclusions.values())\\n    rate = (success / total * 100) if total > 0 else 0\\n    print(f\\\"\\\\nSuccess Rate: {rate:.1f}%\\\")\\n```\\n\\n### Find Failed Run Details\\n```python\\nimport json\\n\\nwith open('health-data/w1_failed_runs.json') as f:\\n    data = json.load(f)\\n    \\n    print(f\\\"Failed Runs: {len(data['workflow_runs'])}\\\")\\n    for run in data['workflow_runs'][:5]:\\n        print(f\\\"\\\\nRun #{run['run_number']}\\\")\\n        print(f\\\"  Name: {run['name']}\\\")\\n        print(f\\\"  Branch: {run['head_branch']}\\\")\\n        print(f\\\"  Created: {run['created_at']}\\\")\\n        print(f\\\"  Duration: {run['status']} -> {run['conclusion']}\\\")\\n```\\n\\n---\\n\\n## Reporting Examples\\n\\n### Generate Weekly Report\\n```bash\\n#!/bin/bash\\n\\nDATE=$(date +%Y-%m-%d)\\nREPORT=\\\"health_report_${DATE}.txt\\\"\\n\\ncat > \\\"$REPORT\\\" << EOF\\n# Health Data Report - $DATE\\n\\n## Metrics Summary\\nEOF\\n\\npython3 << 'PYTHON'\\nimport json\\n\\nmetrics = {\\n    'Untriaged Issues': ('health-data/m1_untriaged.json', 'items'),\\n    'Awaiting Input': ('health-data/m2_awaiting_input.json', 'items'),\\n    'Open PRs': ('health-data/m4_open_prs.json', 'items'),\\n    'Failed CI Runs': ('health-data/w1_failed_runs.json', 'workflow_runs'),\\n    'P0 Issues': ('health-data/c1_p0.json', 'items'),\\n    'P1 Issues': ('health-data/c1_p1.json', 'items'),\\n    'Open Bugs': ('health-data/c2_bugs.json', 'items'),\\n}\\n\\nfor name, (file, key) in metrics.items():\\n    try:\\n        with open(file) as f:\\n            data = json.load(f)\\n            count = len(data.get(key, []))\\n            print(f\\\"{name}: {count}\\\")\\n    except:\\n        print(f\\\"{name}: ERROR\\\")\\nPYTHON\\n\\necho \\\"\\nReport generated: $REPORT\\\"\\n```\\n\\n---\\n\\n## Performance Tips\\n\\n1. **Load JSON once:**\\n   ```python\\n   data = json.load(open('file.json'))\\n   for item in data['items']:\\n       # process\\n   ```\\n\\n2. **Use generators for large files:**\\n   ```python\\n   def load_items(filename):\\n       with open(filename) as f:\\n           data = json.load(f)\\n           for item in data.get('items', []):\\n               yield item\\n   ```\\n\\n3. **Cache results:**\\n   ```python\\n   import json\\n   from datetime import datetime, timedelta\\n   \\n   cache_file = 'analysis_cache.json'\\n   cache_age_limit = 3600  # 1 hour\\n   \\n   try:\\n       stat = os.stat(cache_file)\\n       if time.time() - stat.st_mtime < cache_age_limit:\\n           with open(cache_file) as f:\\n               cached_data = json.load(f)\\n   except:\\n       # Recompute if cache missing or old\\n       pass\\n   ```\\n\\n---\\n\\n## Common Queries\\n\\n### List all issue titles and numbers\\n```bash\\npython3 -c \\\"\\nimport json\\nimport sys\\n\\nfor file in sys.argv[1:]:\\n    with open(file) as f:\\n        data = json.load(f)\\n        for issue in data.get('items', []):\\n            print(f\\\\\\\"#{issue['number']}: {issue['title']}\\\\\\\")\\n\\\" health-data/*.json | sort | uniq\\n```\\n\\n### Count total items across all files\\n```bash\\npython3 -c \\\"\\nimport json\\nimport os\\n\\ntotal = 0\\nfor file in os.listdir('health-data'):\\n    if file.endswith('.json'):\\n        with open(f'health-data/{file}') as f:\\n            data = json.load(f)\\n            count = len(data.get('items', data.get('workflow_runs', [])))\\n            total += count\\n            print(f'{file}: {count}')\\n\\nprint(f'\\\\nTotal: {total}')\\n\\\"\\n```\\n\\n---\\n\\n## Advanced Analysis\\n\\n### Issue Lifecycle Analysis\\n```python\\nimport json\\nfrom datetime import datetime\\n\\nwith open('health-data/c7_closed_issues.json') as f:\\n    data = json.load(f)\\n    \\n    lifespans = []\\n    for issue in data['items']:\\n        created = datetime.fromisoformat(issue['created_at'].replace('Z', '+00:00'))\\n        closed = datetime.fromisoformat(issue['closed_at'].replace('Z', '+00:00'))\\n        lifespan = (closed - created).days\\n        lifespans.append(lifespan)\\n    \\n    avg_lifespan = sum(lifespans) / len(lifespans) if lifespans else 0\\n    print(f\\\"Average issue lifetime: {avg_lifespan:.0f} days\\\")\\n    print(f\\\"Min: {min(lifespans)} days\\\")\\n    print(f\\\"Max: {max(lifespans)} days\\\")\\n```\\n\\n---\\n\\n**For more examples, see the analysis script and documentation files.**\\n\",\"path\":\"/home/runner/work/GH-AW-Tests/GH-AW-Tests/USAGE_EXAMPLES.md\"}",
