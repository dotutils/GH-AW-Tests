n\\n\\n# W3 - Cancelled Runs (24h)\\necho \\\"Collecting W3: Cancelled Runs...\\\"\\ngh run list -R \\\"$REPO\\\" --branch main --limit 100 --json databaseId,name,status,conclusion,createdAt,event,url \\u003e w3-raw.json\\n\\n# W4 - Azure DevOps Status\\necho \\\"Collecting W4: Azure DevOps...\\\"\\ngh issue list -R \\\"$REPO\\\" --label \\\"blocking-clean-ci\\\" --state open --limit 100 --json number,title,createdAt,author,labels,url \\u003e w4-blocking-ci.json\\ngh issue list -R \\\"$REPO\\\" --label \\\"Known Build Error\\\" --state open --limit 100 --json number,title,createdAt,author,labels,url \\u003e w4-build-errors.json\\n\\n# C1 - High Priority Bugs\\necho \\\"Collecting C1: Priority Bugs...\\\"\\ngh issue list -R \\\"$REPO\\\" --label \\\"P0\\\" --state open --limit 100 --json number,title,createdAt,author,labels,url \\u003e c1-p0.json\\ngh issue list -R \\\"$REPO\\\" --label \\\"P1\\\" --state open --limit 100 --json number,title,createdAt,author,labels,url \\u003e c1-p1.json\\n\\n# C2 - Bug Count\\necho \\\"Collecting C2: Bug Count...\\\"\\ngh issue list -R \\\"$REPO\\\" --label \\\"bug\\\" --state open --limit 100 --json number,title,createdAt,author,labels,url \\u003e c2-raw.json\\n\\n# C5 - Security Issues\\necho \\\"Collecting C5: Security Issues...\\\"\\ngh issue list -R \\\"$REPO\\\" --label \\\"Security\\\" --state open --limit 100 --json number,title,createdAt,author,labels,url \\u003e c5-raw.json\\n\\n# C7 - Issue Velocity\\necho \\\"Collecting C7: Issue Velocity...\\\"\\ngh issue list -R \\\"$REPO\\\" --state all --limit 200 --json number,title,createdAt,closedAt,state,author,url \\u003e c7-issues.json\\ngh pr list -R \\\"$REPO\\\" --state closed --limit 200 --json number,title,createdAt,closedAt,mergedAt,state,author,url \\u003e c7-prs.json\\ngh api \\\"repos/$REPO\\\" --jq '{open_issues_count: .open_issues_count, stargazers_count: .stargazers_count, forks_count: .forks_count, watchers_count: .watchers_count}' \\u003e c7-repo-info.json\\n\\n# 